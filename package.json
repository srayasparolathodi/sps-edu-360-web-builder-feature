{
  "name": "spsedu360",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm exec nx run-many -t build",
    "format": "prettier \"{apps,api,libs,scripts}/**/*.{ts,tsx,js,json,mjs}\" --ignore-path .gitignore",
    "format:check": "pnpm format --check",
    "format:write": "pnpm format --write",
    "lint": "pnpm exec nx run-many -t lint",
    "tsc": "pnpm exec nx run-many -t tsc",
    "validate": "pnpm format:write && pnpm tsc && pnpm lint",
    "prepare": "husky",
    "dev:web-builder": "node scripts/dev-web-builder.mjs",
    "build:web-builder": "pnpm --filter @spsedu360/web-builder build",
    "deploy:web-builder": "pnpm build:web-builder && wrangler deploy",
    "test:web-builder": "pnpm --filter @spsedu360/web-builder --filter @spsedu360/web-builder-api --filter @spsedu360/engine test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nx/angular": "^24.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nx": "^24.0.0",
    "prettier": "^3.9.10",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0"
}
